            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 10,\n  \"pickupDatetime\": \"2026-10-26T09:00:00\",\n  \"expectedReturnDatetime\": \"2026-10-28T09:00:00\",\n  \"pickupLocation\": \"Hitec City, Hyderabad\",\n  \"dropLocation\": \"Hitec City, Hyderabad\",\n  \"notes\": \"Weekend family road trip\"\n}"
