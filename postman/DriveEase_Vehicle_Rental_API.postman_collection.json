{
  "info": {
    "_postman_id": "c88f1d24-3420-4ee0-8bbf-driveease-rentals",
    "name": "DriveEase Rentals - Vehicle Rental System API Collection",
    "description": "Complete Postman collection for DriveEase Rentals full-stack application covering Auth, Vehicles, Bookings, Returns, and Admin Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Customer Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aman Verma\",\n  \"email\": \"aman@gmail.com\",\n  \"mobileNumber\": \"9876501234\",\n  \"password\": \"customer123\",\n  \"confirmPassword\": \"customer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@driveease.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Authenticated User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Vehicles (Public & Browsing)",
      "item": [
        {
          "name": "List All Vehicles (Public - Masked Reg)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"]
            }
          }
        },
        {
          "name": "Filter Vehicles (Cars / Two-Wheelers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles?category=CAR&subCategory=SUV&sortBy=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"],
              "query": [
                {
                  "key": "category",
                  "value": "CAR"
                },
                {
                  "key": "subCategory",
                  "value": "SUV"
                },
                {
                  "key": "sortBy",
                  "value": "price_asc"
                }
              ]
            }
          }
        },
        {
          "name": "Calculate Price & Availability Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 4,\n  \"pickupDatetime\": \"2026-10-25T10:00:00\",\n  \"expectedReturnDatetime\": \"2026-10-25T20:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vehicles/calculate-price",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles", "calculate-price"]
            }
          }
        },
        {
          "name": "Search Available Vehicles For Dates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles/search?category=CAR&pickup=2026-10-25T10:00:00&returnTime=2026-10-26T10:00:00&location=Mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles", "search"],
              "query": [
                {
                  "key": "category",
                  "value": "CAR"
                },
                {
                  "key": "pickup",
                  "value": "2026-10-25T10:00:00"
                },
                {
                  "key": "returnTime",
                  "value": "2026-10-26T10:00:00"
                },
                {
                  "key": "location",
                  "value": "Mumbai"
                }
              ]
            }
          }
        }
      ]
    },
    {
